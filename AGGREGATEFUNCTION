scala> val data = seq(“Diane Murphy”,”Accounting”,8435), (“Mary”,”Acc”,9998),
(“Jeff”,”Acc”,8992), (“Willian”,”Acc”,8870), (“Gerard”,”Acc”,11472), (“Bow”,”Acc”,6627), (“Leslie
